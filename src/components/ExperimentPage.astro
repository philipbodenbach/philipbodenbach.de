---
import SiteLayout from "./SiteLayout.astro";
import ExperimentBrief from "./ExperimentBrief.astro";
import ExperimentTechnical from "./ExperimentTechnical.astro";
import { labContent } from "../i18n/lab";
import type { Locale } from "../i18n/home";
import { experimentPath, type Experiment } from "../data/experiments";
import { absoluteUrl } from "../lib/seo";
interface Props { locale: Locale; experiment: Experiment; }
const { locale, experiment } = Astro.props;
const ui = labContent[locale];
const copy = experiment.copy[locale];
const technical = experiment.technical?.[locale];
const schema = {
  "@context": "https://schema.org", "@type": "Article",
  headline: copy.title, description: copy.description,
  inLanguage: locale, datePublished: experiment.date,
  image: absoluteUrl(experiment.image),
  author: { "@type": "Person", name: "Philip Bodenbach", url: absoluteUrl("/") },
  mainEntityOfPage: absoluteUrl(experimentPath(experiment, locale)),
};
---
<SiteLayout locale={locale} pageKey={experiment.pageKey} title={`${copy.title} – Lab | Philip Bodenbach`} description={copy.description} imageUrl={absoluteUrl(experiment.socialImage)} imageAlt={copy.imageAlt} schema={schema}>
  <article>
    <header class="mx-auto max-w-6xl px-5 py-14 sm:px-6 lg:px-8">
      <a class="text-link" href={ui.path}><span aria-hidden="true">←</span> {ui.back}</a>
      <p class="section-label mt-10">{ui.experiment} · <time datetime={experiment.date}>{new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "UTC" }).format(new Date(experiment.date))}</time></p>
      <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight tracking-tight sm:text-6xl">{copy.title}</h1>
      <p class="mt-7 max-w-3xl text-lg leading-8 text-neutral-700 dark:text-neutral-300">{copy.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={experiment.demoUrl} class="button-primary">{ui.play} <span aria-hidden="true">↗</span></a>
        <a href={experiment.sourceUrl} class="button-secondary">{ui.source}</a>
        {technical && <a href="#technical" class="button-secondary">{technical.label} <span aria-hidden="true">↓</span></a>}
      </div>
    </header>
    {experiment.brief && <ExperimentBrief brief={experiment.brief} locale={locale} />}
    <section class="border-y border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:px-6 md:grid-cols-[1fr_1fr] lg:gap-16 lg:px-8">
        <figure>
          <video class="lab-video" controls playsinline preload="none" poster={experiment.image} width="720" height="916" aria-label={ui.video}>
            <source src={experiment.video} type="video/mp4" />
            <a href={experiment.video}>{ui.videoFallback}</a>
          </video>
          <figcaption class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">{ui.videoCaption}</figcaption>
        </figure>
        <div class="self-center">
          <p class="section-label">{ui.about}</p>
          <h2 class="section-heading">{ui.setup}</h2>
          <dl class="mt-8 divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800">
            {copy.facts.map(fact => <div class="py-5"><dt class="text-sm text-neutral-500 dark:text-neutral-400">{fact.label}</dt><dd class="mt-1 break-words font-medium">{fact.value}</dd></div>)}
          </dl>
          <p class="mt-7 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{ui.artifactText}</p>
        </div>
      </div>
    </section>
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 lg:px-8">
      {technical && <ExperimentTechnical report={technical} />}
      <div class:list={["max-w-3xl space-y-10", { "mt-14": technical }]}>
        {copy.sections.map(section => <section><h2 class="text-2xl font-semibold">{section.title}</h2><p class="mt-4 text-lg leading-8 text-neutral-700 dark:text-neutral-300">{section.text}</p></section>)}
      </div>
      <section class="mt-14 border-t border-neutral-200 pt-10 dark:border-neutral-800">
        <h2 class="text-2xl font-semibold">{ui.artifact}</h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-neutral-600 dark:text-neutral-400">{ui.controls}</p>
        <div class="mt-6 flex flex-wrap gap-3"><a class="button-primary" href={experiment.demoUrl}>{ui.play} <span aria-hidden="true">↗</span></a><a class="button-secondary" href={experiment.sourceUrl}>{ui.source}</a></div>
      </section>
      <nav aria-label={ui.related} class="mt-12 flex flex-wrap gap-6 border-t border-neutral-200 pt-8 dark:border-neutral-800">
        <span class="text-neutral-500 dark:text-neutral-400">{ui.related}</span>
        <a class="text-link" href={`https://philipbodenbach.github.io/werkWorker/${locale === "de" ? "de/" : ""}`}>WerkWorker ↗</a>
        <a class="text-link" href="https://philipbodenbach.github.io/werk1112/">Werk1112 ↗</a>
      </nav>
    </div>
  </article>
</SiteLayout>
