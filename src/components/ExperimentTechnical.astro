---
import type { TechnicalReport } from "../data/technical";
interface Props { report: TechnicalReport; }
const { report } = Astro.props;
---
<section id="technical" aria-labelledby="technical-title" class="scroll-mt-8 border-b border-neutral-200 pb-14 dark:border-neutral-800">
  <p class="section-label">{report.label}</p>
  <h2 id="technical-title" class="section-heading">{report.title}</h2>
  <p class="mt-5 max-w-3xl text-lg leading-8 text-neutral-700 dark:text-neutral-300">{report.intro}</p>

  <dl class="mt-8 grid grid-cols-1 gap-3 min-[360px]:grid-cols-2 sm:gap-4 lg:grid-cols-4">
    {report.summary.map(metric => (
      <div class="rounded-lg border border-neutral-200 bg-white p-4 sm:p-6 dark:border-neutral-800 dark:bg-neutral-900">
        <dt class="text-sm font-medium text-neutral-600 dark:text-neutral-400">{metric.label}</dt>
        <dd class="mt-3 text-2xl font-semibold tracking-tight text-balance text-teal-800 tabular-nums sm:text-3xl dark:text-teal-300">{metric.value}</dd>
        <dd class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{metric.note}</dd>
      </div>
    ))}
  </dl>

  <section class="mt-12" aria-labelledby="method-title">
    <h3 id="method-title" class="text-2xl font-semibold">{report.method.title}</h3>
    <ol class="mt-6 grid gap-x-10 gap-y-7 md:grid-cols-2">
      {report.method.steps.map((step, index) => (
        <li class="flex gap-4">
          <span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full border border-teal-800/20 text-sm font-medium text-teal-800 dark:border-teal-300/30 dark:text-teal-300">{index + 1}</span>
          <div class="min-w-0">
            <h4 class="pt-1 font-semibold">{step.title}</h4>
            <p class="mt-2 break-words text-base leading-7 text-neutral-700 dark:text-neutral-300">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <div class="mt-12 grid gap-6 lg:grid-cols-2">
    {report.groups.map(group => (
      <section class="min-w-0 rounded-lg border border-neutral-200 bg-white p-5 sm:p-6 dark:border-neutral-800 dark:bg-neutral-900">
        <h3 class="text-xl font-semibold">{group.title}</h3>
        <dl class="mt-5 divide-y divide-neutral-200 dark:divide-neutral-800">
          {group.rows.map(row => (
            <div class="flex flex-wrap justify-between gap-x-4 gap-y-1 py-3 text-sm leading-6">
              <dt class="break-words text-neutral-600 dark:text-neutral-400">{row.label}</dt>
              <dd class="ml-auto break-words text-right font-medium tabular-nums">{row.value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-5 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{group.note}</p>
      </section>
    ))}
  </div>

  <section class="mt-10 max-w-3xl" aria-labelledby="checks-title">
    <h3 id="checks-title" class="text-2xl font-semibold">{report.checks.title}</h3>
    {report.checks.paragraphs.map(paragraph => <p class="mt-4 text-base leading-7 text-neutral-700 dark:text-neutral-300">{paragraph}</p>)}
  </section>

  <details class="mt-10 rounded-lg border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
    <summary class="cursor-pointer rounded-lg px-5 py-5 font-semibold sm:px-6">{report.requests.title}</summary>
    <div class="px-5 pb-6 sm:px-6">
      <p id="requests-note" class="max-w-3xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">{report.requests.note}</p>
      <div class="mt-5 overflow-x-auto rounded-sm" role="region" aria-label={report.requests.title} aria-describedby="requests-note" tabindex="0">
        <table class="w-full whitespace-nowrap text-right text-sm tabular-nums">
          <caption class="sr-only">{report.requests.title}</caption>
          <thead class="border-y border-neutral-200 dark:border-neutral-700">
            <tr>{report.requests.headings.map((heading, i) => <th scope="col" class:list={["px-3 py-3 font-medium", { "text-left": i === 0 }]}>{heading}</th>)}</tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
            {report.requests.rows.map(row => (
              <tr>
                <th scope="row" class="px-3 py-3 text-left font-medium">{row[0]}</th>
                {row.slice(1).map(cell => <td class="px-3 py-3 text-neutral-700 dark:text-neutral-300">{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </details>

  <section class="mt-12" aria-labelledby="evidence-title">
    <h3 id="evidence-title" class="text-2xl font-semibold">{report.evidence.title}</h3>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {report.evidence.images.map(img => (
        <figure class="min-w-0 overflow-hidden rounded-lg border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
          <a class="block bg-[#090d17] p-3" href={img.src} aria-label={`${report.evidence.open}: ${img.title}`}>
            <img src={img.src} width={img.width} height={img.height} loading="lazy" decoding="async" alt={img.alt} class="aspect-[4/3] h-auto w-full object-contain" />
          </a>
          <figcaption class="p-5">
            <p class="font-semibold">{img.title}</p>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{img.caption}</p>
            <a class="text-link mt-4" href={img.src}>{report.evidence.open} <span aria-hidden="true">↗</span></a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="mt-10 max-w-3xl" aria-labelledby="artifact-fingerprint-title">
    <h3 id="artifact-fingerprint-title" class="text-xl font-semibold">{report.artifact.title}</h3>
    <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{report.artifact.text}</p>
    <p class="mt-3 break-all font-mono text-xs leading-6 text-neutral-600 dark:text-neutral-400"><span class="font-semibold">SHA-256</span> {report.artifact.sha256}</p>
    <a class="button-secondary mt-6" href={report.download.href} download="werkworker-tetris-metrics.json">{report.download.label} <span aria-hidden="true">↓</span></a>
    <p class="mt-4 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{report.download.note}</p>
  </section>
</section>
