---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  href: string;
  linkLabel: string;
  secondaryLink?: { href: string; label: string };
  tags?: readonly string[];
  horizontal?: boolean;
  artwork?: boolean;
}
const { eyebrow, title, description, image, imageAlt, href, linkLabel, secondaryLink, tags = [], horizontal = false, artwork = false } = Astro.props;
---

<article class:list={["teaser-card", { "teaser-horizontal": horizontal }]}>
  <a href={href} class:list={["teaser-image", { "teaser-artwork": artwork }]} tabindex="-1" aria-hidden="true">
    <img src={image} alt={imageAlt} width={artwork ? 870 : 880} height={artwork ? 1108 : 234} loading="lazy" decoding="async" />
  </a>
  <div class="teaser-body">
    <p class="section-label">{eyebrow}</p>
    <h3 class="mt-3 text-2xl font-semibold leading-tight text-neutral-950 dark:text-white sm:text-3xl">
      <a href={href} class="hover:text-teal-800 dark:hover:text-teal-200">{title}</a>
    </h3>
    <p class="mt-4 text-base leading-7 text-neutral-700 dark:text-neutral-300">{description}</p>
    {tags.length > 0 && <ul class="mt-5 flex flex-wrap gap-2">{tags.map(tag => <li class="tag">{tag}</li>)}</ul>}
    <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">{href.startsWith("https://") ? "↗" : "→"}</span></a>
      {secondaryLink && <a class="text-link secondary-link" href={secondaryLink.href}>{secondaryLink.label}</a>}
    </div>
  </div>
</article>
