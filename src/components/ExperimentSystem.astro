---
import type { SystemProfile } from "../data/technical";
interface Props { system: SystemProfile; }
const { system } = Astro.props;
---
<section id="system" aria-labelledby="system-title" class="mt-12 border-t border-neutral-200 pt-10 dark:border-neutral-800">
  <p class="section-label">{system.label}</p>
  <h2 id="system-title" class="section-heading">{system.title}</h2>
  <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {system.specs.map(spec => (
      <div class="min-w-0 rounded-lg border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
        <dt class="text-sm font-medium text-neutral-600 dark:text-neutral-400">{spec.label}</dt>
        <dd class="mt-3 text-xl font-semibold leading-7 text-balance text-teal-800 dark:text-teal-300">{spec.value}</dd>
        <dd class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{spec.detail}</dd>
      </div>
    ))}
  </dl>
  <p class="mt-5 max-w-3xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">{system.provenance}</p>
  <details class="mt-5 rounded-lg border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
    <summary class="cursor-pointer rounded-lg px-5 py-4 font-semibold sm:px-6">{system.detailsTitle}</summary>
    <div class="px-5 pb-6 sm:px-6">
      <dl class="divide-y divide-neutral-200 dark:divide-neutral-800">
        {system.rows.map(row => (
          <div class="grid gap-1 py-3 text-sm leading-6 sm:grid-cols-[1fr_2fr] sm:gap-6">
            <dt class="text-neutral-600 dark:text-neutral-400">{row.label}</dt>
            <dd class="min-w-0 break-words font-medium tabular-nums">{row.value}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 max-w-3xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">{system.note}</p>
    </div>
  </details>
</section>
